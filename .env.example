# Copia questo file in ".env" (cp .env.example .env) e compila i valori.
# Il file ".env" è ignorato da git: resta solo sul tuo computer.

# Client ID dell'app creata su https://developer.spotify.com/dashboard
# Grazie al login PKCE NON serve il client secret.
SPOTIFY_CLIENT_ID=

# Deve coincidere ESATTAMENTE con il Redirect URI registrato nella dashboard.
# Usa 127.0.0.1, non "localhost" (Spotify non lo accetta più).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Opzionale: serve solo se in config.toml scegli provider = "lastfm" per i generi.
# Chiave gratuita su https://www.last.fm/api/account/create
LASTFM_API_KEY=
